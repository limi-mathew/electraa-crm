{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint resources/js --ext .js,.vue",
    "lint:fix": "eslint resources/js --ext .js,.vue --fix",
    "format": "prettier --write resources/**/*.{js,vue,css,blade.php}",
    "quality": "npm run lint:fix && npm run format && vendor/bin/pint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "axios": "^1.16.1",
    "concurrently": "^9.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "laravel-echo": "^2.3.4",
    "laravel-vite-plugin": "^3.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-blade": "^3.1.6",
    "pusher-js": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
